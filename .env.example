# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - BRAZO ROBÓTICO CON IA PARA AJEDREZ (KAIROS CORE)
# Copiar este archivo a '.env' y ajustar las credenciales según el entorno local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL - pgAdmin local / Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_aqui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ajedrez

# URL de conexión SQLAlchemy consumida por el backend FastAPI
DATABASE_URL=postgresql+psycopg2://postgres:tu_password_aqui@localhost:5432/ajedrez

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y AUTENTICACIÓN JWT
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=tu_clave_secreta_jwt_para_firmar_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# 3. CONTROL DE ROLES Y PRIVILEGIOS DE FACILITADOR
# ------------------------------------------------------------------------------
# PIN de seguridad requerido para registrarse manualmente con el rol de Facilitador
CLAVE_REGISTRO_FACILITADOR=admin123

# Lista blanca de correos autorizados automáticamente con rol Facilitador (separados por coma)
CORREOS_FACILITADORES=suarezburgoshebert@gmail.com,facilitador@test.com,admin@kairos-chess.ai

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Google Identity Services)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. SERVICIOS COMPLEMENTARIOS (OPCIONALES)
# ------------------------------------------------------------------------------
# Ruta al motor Stockfish si se instala externamente
# STOCKFISH_PATH=C:/Program Files/Stockfish/stockfish.exe

# Origen de captura de cámara para visión por computadora (índice o URL RTSP/HTTP)
CAMARA_FUENTE=0
