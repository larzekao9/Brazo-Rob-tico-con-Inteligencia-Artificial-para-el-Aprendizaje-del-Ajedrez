# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - BRAZO ROBÓTICO CON IA PARA AJEDREZ (KAIROS CORE)
# Copiar este archivo a '.env' y ajustar las credenciales según el entorno local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL - pgAdmin local / Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_aqui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ajedrez

# URL de conexión SQLAlchemy consumida por el backend FastAPI
DATABASE_URL=postgresql+psycopg2://postgres:tu_password_aqui@localhost:5432/ajedrez

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y AUTENTICACIÓN JWT
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=tu_clave_secreta_jwt_para_firmar_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# 3. CONTROL DE ROLES Y PRIVILEGIOS DE FACILITADOR
# ------------------------------------------------------------------------------
# PIN de seguridad requerido para registrarse manualmente con el rol de Facilitador
CLAVE_REGISTRO_FACILITADOR=admin123

# Lista blanca de correos autorizados automáticamente con rol Facilitador (separados por coma)
CORREOS_FACILITADORES=suarezburgoshebert@gmail.com,facilitador@test.com,admin@kairos-chess.ai

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Google Identity Services)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. SERVICIOS COMPLEMENTARIOS (OPCIONALES)
# ------------------------------------------------------------------------------
# Ruta al motor Stockfish si se instala externamente
# STOCKFISH_PATH=C:/Program Files/Stockfish/stockfish.exe

# Origen de captura de cámara para visión por computadora (índice o URL RTSP/HTTP)
CAMARA_FUENTE=0

# ------------------------------------------------------------------------------
# 6. TUTOR TURING (Groq API — GroqCloud, tier gratuito)
# ------------------------------------------------------------------------------
# Generar la key en https://console.groq.com (API Keys). Confirmar en
# https://console.groq.com/docs/models que el modelo sigue disponible y
# soporta tool calling antes de desplegar — el catálogo de Groq cambia seguido.
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 7. PANEL DE ENTRENAMIENTO DEL FACILITADOR (HU4 — dataset, no el reentrenamiento en sí)
# ------------------------------------------------------------------------------
# Cuántas partidas válidas nuevas hacen falta para que el panel marque "listo para
# entrenar" (ver docs/plan_sprints.md, HU4: "después de N partidas (ej. 10)").
UMBRAL_PARTIDAS_ENTRENAMIENTO=10

# ------------------------------------------------------------------------------
# 8. PRODUCCIÓN (Supabase u otra base gestionada) — ver docs/base_de_datos/DESPLIEGUE_SUPABASE.md
# ------------------------------------------------------------------------------
# Los usuarios de prueba (facilitador@test.com, jugador@test.com...) tienen contraseñas
# fijas conocidas. Se crean al arrancar salvo en bases *.supabase.co / *.supabase.com.
# En cualquier despliegue real dejar esta variable en false.
# SEMBRAR_USUARIOS_PRUEBA=false
#
# Ejemplo de DATABASE_URL para Supabase (Session pooler, IPv4). Reemplazar <ref>, <region>
# y <PASSWORD> (con caracteres especiales codificados, ej. @ -> %40):
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# En producción CLAVE_REGISTRO_FACILITADOR NO puede ser admin123 y CORREOS_FACILITADORES
# debe listar solo correos reales (sin facilitador@test.com).
